{
  "name": "skillsphere-server",
  "private": true,
  "version": "2.0.0",
  "description": "SkillSphere Intelligence Engine — Production Backend",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  },
  "license":"MIT",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "start:migrate": "npx prisma generate && npx prisma migrate deploy && node index.js",
    
    "dev:cluster": "pm2 start pm2.config.cjs --env development",
    "prod": "pm2 start pm2.config.cjs --env production",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "pm2": "^5.3.1",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
