

# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────
# Local:   postgresql://USER:PASSWORD@localhost:5432/skillsphere
# Supabase: get from project settings → database → connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillsphere

# ── Auth ──────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_WHITELIST=kshitizd171@gmail.com
ADMIN_ESCALATION_KEY=SkillSphereAdmin2026!

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production: set to your real frontend URL e.g. https://skillsphere.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (OPTIONAL) ─────────────────────────────────────────
# Leave blank to use fast in-memory cache (fine for development).
# For production: use Redis Cloud (free tier) → https://redis.io/try-free
# Standard format:  redis://default:PASSWORD@HOST:PORT
# Upstash TLS:      rediss://default:PASSWORD@HOST:PORT
REDIS_URL=

# ── GitHub (OPTIONAL but recommended) ─────────────────────────
# Without token: 60 req/hour  |  With token: 5 000 req/hour
# Get one at: github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=your-github-personal-access-token

# ── AI / Gemini ───────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key

# ── SMTP (Email) ──────────────────────────────────────────────
# For Gmail: use an App Password (NOT your account password).
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password